#!/usr/bin/env bash
set -euo pipefail

launcher="walker"
launcher_opts="--dmenu -p Utilities"
if ! command -v "$launcher" >/dev/null 2>&1; then
  if command -v dmenu >/dev/null 2>&1; then
    launcher="dmenu"
  else
    echo "walker or dmenu not found" >&2
    exit 1
  fi
fi

options="  Bluetooth\n󰍛  btop\n󰄛  Calcurse\n󰀻  Audio Mixer"
choice=$(printf "%b" "$options" | $launcher $launcher_opts)

case "$choice" in
  *Bluetooth*) kitty-tui -e bluetui ;;
  *btop*) kitty-tui -e btop ;;
  *Calcurse*) kitty-tui -e calcurse ;;
  *Audio*) kitty-tui -e wiremix ;;
esac
